/docs-OLD/
docs/

# Hier wohnen Monster, riesig, auf jeden Fall ignorieren:
*_cache/
*_html/

# Rendered website output is not tracked on main; it is built locally
# and published by merging docs/ into the gh-pages branch (not via
# `quarto publish`, which would mirror-delete posts that fail to
# render locally):
_site/
site_libs/
*_files/

# Do not track html files
**/*.html

# knitr's default figure names for unnamed chunks (old-style .rmd posts
# that place output directly in the post folder instead of a *_files/
# subdir); regenerated on every render, so treat like other build output.
# Named-chunk figures are left tracked since some post folders also
# contain manually placed images that can't be regenerated.
**/unnamed-chunk-*.png
**/unnamed-chunk-*.jpg
**/unnamed-chunk-*.jpeg

